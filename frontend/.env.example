# ── Frontend API URL ─────────────────────────────────────────
# For local development (copy to .env and use as-is):
VITE_API_URL=http://localhost:5000/api

# For production deployment on Netlify, set this environment variable to:
# VITE_API_URL=https://cnps-ouwq.onrender.com/api
#
# In Netlify: Site Settings → Environment Variables → Add variable
# Key:   VITE_API_URL
# Value: https://cnps-ouwq.onrender.com/api
