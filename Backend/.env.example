# ============================================================
# CNPS CMS Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000

# ── Frontend origin (for CORS) ───────────────────────────────
# Development:  http://localhost:5173
# Production:   https://cnpspublicschool.netlify.app
FRONTEND_URL=http://localhost:5173

# ── MySQL Database ────────────────────────────────────────────
# Local development:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cnpscholl_cms
DB_USER=root
DB_PASSWORD=

# Railway MySQL (production example — use your actual values):
# DB_HOST=mysql.railway.internal
# DB_PORT=3306
# DB_NAME=railway
# DB_USER=root
# DB_PASSWORD=<your-railway-password>

# ── JWT Authentication ────────────────────────────────────────
# Use a long, random, unpredictable string in production.
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d

# ── Email / SMTP (for OTP password reset) ─────────────────────
# Gmail example — use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=CNPS PUBLIC SCHOOL
