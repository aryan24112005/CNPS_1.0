# ============================================================
# CNPS Public School Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/cnps_school
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/cnps_school
MONGODB_URI=mongodb://localhost:27017/cnps_school

# ── JWT ─────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=1d

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# The production Netlify URL is always allowed (hardcoded in server.js).
# For local development add localhost here:
FRONTEND_URL=http://localhost:5173
# For production on Render, set this to:
# FRONTEND_URL=https://cnpspublicschool.netlify.app,http://localhost:5173

# ── Cloudinary (Persistent Image Storage) ───────────────────
# Get from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SMTP (preserved — for local/dev environments where SMTP is reachable) ───
# Render blocks outbound TCP on ports 587 and 465 — SMTP will time out there.
# These variables are kept so SMTP can be used in environments where it works.
# Production email on Render uses the Gmail API section below instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# Gmail App Password — generate at https://myaccount.google.com/apppasswords
SMTP_PASS=idmw pwmn pscu scva
SMTP_FROM_NAME=CNPS Public School
SMTP_FROM_EMAIL=your@gmail.com

# ── MySQL (for Hostinger migration) ─────────────────────────
# Set these when deploying to a MySQL/MariaDB environment.
# Not required while running on MongoDB.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASS=your_mysql_password
MYSQL_DB=cnps_school


# Render blocks outbound SMTP; email is sent via Gmail API over HTTPS instead.
# Follow these steps once to obtain credentials:
#
#  1. Go to https://console.cloud.google.com
#  2. Create or select a project.
#  3. Enable the Gmail API: APIs & Services → Library → search "Gmail API" → Enable.
#  4. Create OAuth credentials: APIs & Services → Credentials →
#       Create Credentials → OAuth 2.0 Client ID → Application type: Web application.
#  5. Add "https://developers.google.com/oauthplayground" as an Authorized Redirect URI.
#  6. Go to https://developers.google.com/oauthplayground
#       → click ⚙ (top-right) → check "Use your own OAuth credentials"
#       → paste your Client ID and Client Secret.
#  7. In Step 1, scroll to "Gmail API v1", select:
#         https://www.googleapis.com/auth/gmail.send
#       Click "Authorize APIs" and sign in with your sender Gmail account.
#  8. In Step 2, click "Exchange authorization code for tokens".
#  9. Copy the "Refresh token" → paste as GMAIL_REFRESH_TOKEN below.
# 10. Set GMAIL_SENDER_ADDRESS to the Gmail account you authorised in step 7.
#
# Required on Render (Environment Variables):
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_SENDER_ADDRESS=your@gmail.com
