# ============================================================
# CNPS Public School Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/cnps_school
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/cnps_school
MONGODB_URI=mongodb://localhost:27017/cnps_school

# ── JWT ─────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=1d

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# The production Netlify URL is always allowed (hardcoded in server.js).
# For local development add localhost here:
FRONTEND_URL=http://localhost:5173
# For production on Render, set this to:
# FRONTEND_URL=https://cnpspublicschool.netlify.app,http://localhost:5173

# ── Cloudinary (Persistent Image Storage) ───────────────────
# Get from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (SMTP / Gmail App Password) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# Gmail: generate a 16-char App Password at https://myaccount.google.com/apppasswords
# Paste it with or without spaces — spaces are stripped automatically.
SMTP_PASS=xxxx xxxx xxxx xxxx
# Display name and From address in sent emails:
SMTP_FROM_NAME=CNPS Public School
SMTP_FROM_EMAIL=your@gmail.com
